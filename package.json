{
  "name": "joules",
  "version": "1.0.0",
  "packageManager": "pnpm@11.6.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --verbose",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "expo": "^57.0.10",
    "expo-camera": "~57.0.3",
    "expo-font": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-splash-screen": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.12",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-health-connect": "^3.5.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "expo-modules-core": "57.0.9",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-ml-kit/text-recognition"
        ]
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
